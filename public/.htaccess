# Hostinger (Apache/LiteSpeed) settings for the static export.

# Branded 404 page for broken links
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Pages and data: always revalidate, so a new deploy shows on the next load
  <FilesMatch "\.(html|txt|xml|pdf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Next.js scripts, styles and fonts have content hashes in their names,
  # so they can be cached for a year
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images: cache for a day
  <FilesMatch "\.(png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
